		{
			"bank": 4,
			"offset": 144,
			"count": 35,
			"messages": [
				{
					"offset": 970,
					"text": "5 \"I hope we're insured against violent death.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1030,
					"text": "5 \"I never wanted to be a mercenary.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1080,
					"text": "5 \"If we get separated, rendezvous just ahead of the target site.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1160,
					"text": "5 \"This certainly makes a change from the dull concrete of New Europe.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1244,
					"text": "5 \"Remind me to take some holiday snaps next time we're here.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1320,
					"text": "5 \"Atmosphere's fine.  Nothing toxic in the air.  We'll live.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1396,
					"text": "5 \"There's a lot of ground to cover, so let's make this quick.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1472,
					"text": "5 \"Most of the things we'll find will be larger than we are.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1546,
					"text": "5 \"Try and keep out of trouble.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1592,
					"text": "5 \"I've got an itchy trigger finger.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1642,
					"text": "5 * SIGH * \"I hope I'm still getting my overtime after all this.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1720,
					"text": "5 \"We should have brought everybody along.  Four isn't nearly enough.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1804,
					"text": "5 \"Who brought the picnic hamper?\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1852,
					"text": "5 \"Stay sharp.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1880,
					"text": "5 \"This place gives me the creeps.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1928,
					"text": "5 \"Stay frosty and alert.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1968,
					"text": "5 \"What a stink!\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 1998,
					"text": "5 \"I once heard of a place on Earth where the weather was as unpredictable as this.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2096,
					"text": "5 \"If we make it through this - the drinks are on me.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2164,
					"text": "5 \"Our chances? Fifty fifty I'd say.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2214,
					"text": "5 \"Stop making so much noise!\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2258,
					"text": "5 \"Don't worry. I'm in control.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2304,
					"text": "5 \"Its so cold.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2334,
					"text": "5 \"Its too hot.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2364,
					"text": "5 \"All this running about is killing me.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2418,
					"text": "5 \"Lets go back to the dropship and nuke this site from orbit.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2494,
					"text": "5 \"I'm itching for a good fight.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2494,
					"text": "5 \"I'm itching for a good fight.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2540,
					"text": "5 \"If anyone runs away - there will be hell to pay!\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2606,
					"text": "5 \"The trick is.... to blast them first and then ask questions later.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2690,
					"text": "5 \"What was that?\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2722,
					"text": "5 \"Lets back off and reassess the situation.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2780,
					"text": "5 \"Mean temperature is above micro-clime norm.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2840,
					"text": "5 \"I feel like I'm repeating myself.\"",
					"centre": null,
					"colours": [
						27
					]
				},
				{
					"offset": 2890,
					"text": "5 \"Were not taking any prisoners.\"",
					"centre": null,
					"colours": [
						27
					]
				}
			]
		},
